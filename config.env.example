# =============================================================================
# Invoice Audit Agent demo — deployment configuration
# Copy this file to config.env and edit the values, then run:
#   ./scripts/deploy.sh config.env
# =============================================================================

# --- Azure context ---------------------------------------------------------
AZURE_TENANT_ID="e00660b6-957d-4851-a2b1-26d94d7527cd"
AZURE_SUBSCRIPTION_ID="dde51996-0311-4cae-9195-5f943bd41bc5"
LOCATION="eastus2"                 # Foundry account + model deployments
SEARCH_LOCATION="eastus"           # Azure AI Search (pick a region with serverless capacity)

# --- Naming (keep short, lowercase, alphanumeric + dashes) ------------------
# A short random suffix is appended automatically to globally-unique names
# (Foundry account, Search service, Storage account, App Insights) so the
# script is safe to re-run without colliding with a previous deployment.
RESOURCE_GROUP="rg-invoice-audit-demo"
PROJECT_NAME="invoice-audit-demo"
FOUNDRY_ACCOUNT_NAME="invoice-audit-foundry2"
SEARCH_SERVICE_NAME="invoice-audit-search"
APP_INSIGHTS_NAME="invoice-audit-appinsights"
AGENT_NAME="invoice-audit-agent"
KNOWLEDGE_SOURCE_NAME="servicepro-contract-and-invoices"
KNOWLEDGE_BASE_NAME="invoice-audit-knowledge"
PROJECT_CONNECTION_NAME="invoice-audit-kb-mcp"

# --- Models ------------------------------------------------------------------
# These defaults are widely available Azure OpenAI models. Override if your
# tenant's Foundry model catalog uses different names/versions.
AGENT_MODEL_NAME="gpt-4o"
AGENT_MODEL_VERSION="2024-11-20"
KB_MODEL_NAME="gpt-4o"
KB_MODEL_VERSION="2024-11-20"
EMBEDDING_MODEL_NAME="text-embedding-3-small"
EMBEDDING_MODEL_VERSION="1"
MODEL_SKU_CAPACITY="10"   # in units of 1,000 TPM for GlobalStandard SKU

# --- Behavior flags ----------------------------------------------------------
SEED_SAMPLE_TRAFFIC="true"    # send 3 sample questions to the agent after creation
RBAC_WAIT_TIMEOUT_SECONDS="600"   # max time to wait for each role assignment to propagate
RBAC_POLL_INTERVAL_SECONDS="20"
